# --- Python ---
*.py[cod]
*$py.class
__pycache__/
*.egg-info/
*.egg

# --- Виртуальное окружение ---
.venv/
venv/
ENV/

# --- Django ---
*.log
*.sqlite3
db.sqlite3
staticfiles/
media/

# --- Документы (выгрузки пользователей) ---
*.xls
*.xlsx
*.zip

# --- Шаблоны отчётов: нужны в git ---
# Исключения обязательно ПОСЛЕ правил *.xlsx: в .gitignore побеждает последнее правило.
!core/static/files/*.xlsx

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Переменные окружения ---
.env
.env.local

# --- Тесты ---
.pytest_cache/
.coverage
htmlcov/
