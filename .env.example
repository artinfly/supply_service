# Скопировать в .env и заполнить. Файл .env в git не попадает.
# Все значения необязательные — без них берутся значения по умолчанию из settings.py.

# Секретный ключ Django. На рабочем сервере обязателен свой.
DJANGO_SECRET_KEY=

# True — режим разработки (подробные ошибки, статика без collectstatic).
# На рабочем сервере обязательно False.
DEBUG=True

# Через запятую, без пробелов.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,10.109.42.67,10.10.10.37

DB_NAME=supply_service_test
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
