# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.

# --- Django ---
# DEBUG=True только на рабочем месте разработчика; на сервере — False.
DEBUG=True
SECRET_KEY=change-me-to-a-random-string-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_service
DB_USER=postgres
DB_PASSWORD=password

# --- Внешние сервисы ---
# Адрес HR-сервиса для подтягивания ФИО в админке, например http://hr.local/api/employees/
HR_SERVICE_API_URL=
